{
  "schema": 1,
  "id": "hex-grid",
  "name": "HexGrid",
  "category": "Textures",
  "layer": "background",
  "cost": "low",
  "role": "generator",
  "precision": "highp",
  "glslVersion": "300 es",
  "requires": [],
  "base": null,
