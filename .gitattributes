# 统一以 LF 入库，避免跨平台（Windows/HarmonyOS/CI）行尾差异
* text=auto eol=lf

# GLSL / 文档 / 源码一律 LF
*.glsl text eol=lf
*.vert text eol=lf
*.frag text eol=lf
*.wgsl text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.json5 text eol=lf
*.ts   text eol=lf
*.js   text eol=lf
*.c    text eol=lf
*.h    text eol=lf
*.cpp  text eol=lf
*.hpp  text eol=lf

# Windows 脚本保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# 二进制
*.png  binary
*.jpg  binary
*.webp binary
*.har  binary
*.so   binary
*.a    binary

# 语言统计与 diff（参考图为二进制，不计入行数）
*.png  -diff
*.webp -diff
